<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para subir analisis a Firebase Firestore. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service de grabación IMU continua.
         - dataSync: fallback para Android 10-13 (sin límite de 6 h).
         - specialUse: tipo principal en Android 14+ para evitar el límite acumulativo
           de 6 h que Android 15 impone a dataSync. Requiere justificación explícita en
           el bloque <property> del servicio. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- WakeLock parcial: mantiene la CPU activa con la pantalla apagada. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Muestreo > 200 Hz (Android 12+): necesario para el preset de 400 Hz del
         panel de ajustes, usado al sobre-muestrear frente a caps de firmware. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- Notificación persistente del foreground service (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Necesario para grabar jornadas completas sin que Doze suspenda el proceso. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Watchdog vía AlarmManager: alarmas exactas que despiertan al proceso aunque
         el OEM haya matado el servicio saltándose START_STICKY. USE_EXACT_ALARM es la
         variante de Android 13+ para apps con justificación (grabación continua IMU). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Rearmado del watchdog tras reboot (no auto-arranca grabación por sí mismo). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ScanTestApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScanTest">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScanTest">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            foregroundServiceType="dataSync|specialUse":
              - En Android 14+ (API 34) se arranca con FOREGROUND_SERVICE_TYPE_SPECIAL_USE,
                que no está sujeto al límite acumulativo de 6 h de Android 15.
              - En Android 10-13 (API 29-33) el código usa DATA_SYNC (specialUse no existe
                en esas versiones), que tampoco tiene límite de duración en esas APIs.
            La justificación del tipo specialUse se declara en el <property> obligatorio
            para la revisión de Google Play.
        -->
        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous IMU sensor logging (accelerometer, gyroscope, rotation vector, magnetic field) at 100 Hz for industrial forklift motion analysis in warehouse environments. Sessions run for full work shifts (8-12 h) to collect uninterrupted kinematic data required for safety auditing and operational research. No standard foreground service type (dataSync, health, location) covers long-duration, always-on sensor acquisition without a 6-hour runtime cap on Android 15+." />
        </service>

        <!-- Watchdog: dispara cada 10 min y relanza el servicio si está muerto. -->
        <receiver
            android:name=".service.WatchdogReceiver"
            android:exported="false" />

        <!-- Rearma el watchdog tras un reboot del dispositivo. -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
